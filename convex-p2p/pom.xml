<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<groupId>world.convex</groupId>
		<artifactId>convex</artifactId>
		<version>0.8.12</version>
	</parent>

	<modelVersion>4.0.0</modelVersion>

	<artifactId>convex-p2p</artifactId>

	<name>Convex P2P</name>
	<description>Rollup package for Convex P2P nodes: lattice P2P infrastructure, the
		application regions a node serves, and the node server that serves them</description>
	<url>https://convex.world</url>

	<dependencies>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-core</artifactId>
			<version>${convex.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-peer</artifactId>
			<version>${convex.version}</version>
			<scope>compile</scope>
		</dependency>
		<!-- Rolled-up application regions. This module bundles the regions a node serves
		     so operators run one node server rather than a P2P one and a social one; the
		     dependency runs this way only, and each application stays usable standalone.
		     Add a region here and to P2PLattice.NODE_ROOT together. Regions are selected
		     per node (see P2PNode), not per build. -->
		<dependency>
			<groupId>world.convex</groupId>
			<artifactId>convex-social</artifactId>
			<version>${convex.version}</version>
			<scope>compile</scope>
		</dependency>

		<!-- Logging -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-commons</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>

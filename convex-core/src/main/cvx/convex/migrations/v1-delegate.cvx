;; Network upgrade v1 — convex.trust.delegate library fix (see UPGRADE.md).
;;
;; Applied as part of the v1 genesis upgrade to the convex.trust.delegate actor
;; account, redefining `change-control`. Deliberately NOT part of trust/delegate.cvx
;; / genesis: existing networks keep their genesis hash and reach this fix at
;; protocol version 1.
;;
;; Fixes #623: `change-control` authorised control transfers against action
;; `:change-control`, but the library convention (and the CVM controller checks, and
;; the core trust `change-control`) uses `:control`. A monitor configured per the
;; documented `:control` convention could not authorise a delegate control transfer.
;; Aligns the action keyword to `:control`.
;;
;; Also corrects the `create` / `update` docstrings: `update`'s was copy-pasted from
;; `create` (wrong description and example) and both had malformed :signature
;; metadata. Bodies unchanged.
;;
;; Idempotent: re-applying the corrected definitions is a no-op.

(defn create
  ^{:callable true
    :doc {:description ["Creates a new delegated trust monitor, returning its scope id."]
          :examples    [{:code "(call delegate-actor (create initial-monitor *address*))"}]
          :signature   [{:params [monitor]}
                        {:params [monitor controller]}]}}
  ([monitor]
    (recur monitor *caller*))
  ([monitor controller]
    (let [id next-id
          rec [monitor controller]]
      (set! mons (assoc mons id rec))
      (set! next-id (inc id))
      id)))

(defn update
  ^{:callable true
    :doc {:description ["Updates the delegated monitor for the scoped id, subject to controller trust."]
          :examples    [{:code "(call [delegate-actor id] (update new-monitor))"}]
          :signature   [{:params [new-monitor]}]}}
  [new-monitor]
  (let [rec (mons *scope*)]
    (or rec (fail :ARGUMENT "Delegated trust monitor ID not valid"))
    (or
      (trust/trusted? (second rec) *caller* :update [*address* *scope*])
      (fail :TRUST "Controller not valid"))
    (set! mons (assoc mons *scope* (assoc rec 0 new-monitor)))
    new-monitor))

(defn change-control
  ^{:callable true}
  [controller]
   (let [rec (mons *scope*)]
    (or rec (fail :ARGUMENT "Delegated trust monitor ID not valid"))
    (or
      (trust/trusted? (second rec) *caller* :control [*address* *scope*])
      (fail :TRUST "Controller not valid"))
    (set! mons (assoc mons *scope* (assoc rec 1 controller)))
    controller))

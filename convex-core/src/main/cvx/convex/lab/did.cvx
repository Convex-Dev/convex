'convex.did

;; This is an implementation of the W3C DID specification for a Verifiable Data Registry on Convex
;;
;; This registry backs the `did:convex` DID method as specified in CAD043.
;;
;; Notes
;; - IDs are sequentially allocated integers, internal to this registry. Human readable
;;   naming is provided by CNS: a named DID (e.g. `did:convex:id.foo`) holds a scoped
;;   reference to a registry record (e.g. [~*address* 101]) as its CNS record value.
;; - The required operations Create, Read, Update and Deactivate are implemented on-chain
;; - We regard a nil DDO as deactivated. Deactivation is terminal (per CAD043): a
;;   deactivated DID cannot be updated, re-authorised or transferred.
;; - Records are internally stored as a Vector with the following elements:
;;     0: ddo-document = A string (or nil) containing the DDO
;;     1: controller = address (or trust monitor) to authorise DID updates
;;     2: created = timestamp of DID creation 
;;     3: updated = timestamp of last update
;;     4: accounts = Set of accounts authorised to act on behalf of this identity
;;
;; DIDs can be used as trust monitors, in the form [did-actor-address id] in which case
;; they allow access to the DID's authorised account Set.

(import convex.trust :as trust)

;; A map of [ID -> record vectors]
(def dids {})

;; A counter for unique DID IDs, allocated sequentially
(def counter 1)

(defn 
  ^{:callable true
    :doc       {:description "Gets a DID document for a given account. Returns nil if ID is invalid or DDO does not exist."
                :signature   [{:params [addr]}]}}
  read
  [id]
  (if-let [rec (get dids id)]
    (nth rec 0)))

(defn 
  ^{:callable true
    :doc       {:description "Creates a new DID. Controller will be *caller* unless otherwise specified."
                :signature   [{:params []}
                              {:params [controller]}]}}
  create
  ([]
    (recur *caller*))
  ([controller]
    (let [id counter
          controller (if (callable? controller) controller (fail :ARGUMENT "Invalid controller"))
          rec ["" controller *timestamp* *timestamp* nil]]
      (set! dids (assoc dids id rec))
      (set! counter (inc counter))
      id)))

;; Private helper: get an active (non-deactivated) record, failing appropriately
(defn -active-record
  [id]
  (let [rec (get dids id)]
    (or rec (fail :STATE "Invalid DID"))
    (or (nth rec 0) (fail :STATE "DID is deactivated"))
    rec))

(defn
  ^{:callable true
    :doc       {:description "Reads the full record for a DID as [ddo controller created updated accounts], or nil if the DID does not exist. A nil DDO indicates a deactivated DID."
                :signature   [{:params []}
                              {:params [id]}]}}
  read-record
  ([]
    (recur *scope*))
  ([id]
    (get dids id)))

(defn
  ^{:callable true
    :doc       {:description "Updates a DDO for a DID. DDO can be a String, or nil to deactivate (terminal)."
                :signature   [{:params [id ddo]}]}}
  update
 ([ddo]
   (recur *scope* ddo))
 ([id ddo]
   (or (nil? ddo) (str? ddo) (fail :ARGUMENT "DDO must be a String or nil"))
   (let [rec (-active-record id)
         cont (get rec 1)
         _ (or (trust/trusted? cont *caller* :update id) (fail :TRUST "Unauthorised"))
         rec (assoc rec 0 ddo)         ;; update DDO
         rec (assoc rec 3 *timestamp*) ;; update timestamp
         ]
     (set! dids (assoc dids id rec))
     rec)))

(defn 
  ^{:callable true
    :doc       {:description "Authorises a set of accounts for this DID. May be nil."
                :signature   [{:params [id auth-set]}]}}
  authorise
  ([auth-set]
    (recur *scope* auth-set))
  ([id auth-set]
    (or (nil? auth-set) (set? auth-set) (fail :ARGUMENT "auth-set must be nil or a set of addresses"))
    (let [rec (-active-record id)
          cont (get rec 1)
          _ (or (trust/trusted? cont *caller* :update id) (fail :TRUST "Unauthorised"))
          rec (assoc rec 4 auth-set)    ;; update Authorised account set
          rec (assoc rec 3 *timestamp*) ;; update timestamp
          ]
      (set! dids (assoc dids id rec))
      rec)))

(defn
  ^{:callable true
    :doc       {:description "Sets the controller for a DID. Controller must be an existing account or scoped reference (a plausible trust monitor)."
                :signature   [{:params [id controller]}]}}
  change-control
  ([controller]
    (if (nil? *scope*)
      (fail :TRUST "Changing controller of DID registry not supported")
      (recur *scope* controller)))
  ([id controller]
    (or (callable? controller) (fail :ARGUMENT "Invalid controller"))
    (let [rec (-active-record id)
          cont (get rec 1)
          _ (or (trust/trusted? cont *caller* :control id) (fail :TRUST "Unauthorised"))
          rec (assoc rec 1 controller)    ;; update Authorised account set
       rec (assoc rec 3 *timestamp*) ;; update timestamp
       ]
      (set! dids (assoc dids id rec))
      rec)))

(defn check-trusted?
  ^{:callable true
    :doc       {:description "Trust monitor for DID. Checks if subject is authorised by the DID, where the DID is provided either via a scoped call or the object parameter."
                :signature   [{:params [subject action object]}]}}
  [subject action object]
  (let [id (or *scope* object)
        rec (get dids id)]
    (boolean (and
               rec     ;; not nil
               (nth rec 0) ;; not deactivated
               (address? subject)
               (contains-key? (nth rec 4)
                 (address subject))))))

(defn 
  ^{:callable true
    :doc       {:description "Deactivates a DID."
                :signature   [{:params [id]}]}}
  deactivate
  ([] 
    (update *scope* nil))
  ([id]
    (update id nil)))
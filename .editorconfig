# EditorConfig: https://editorconfig.org (#581)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java sources use tab indentation (repo convention)
[*.java]
indent_style = tab

[*.{xml,json,json5,yml,yaml}]
indent_style = space
indent_size = 2

# Convex Lisp sources
[*.cvx]
indent_style = space
indent_size = 2

# Markdown: trailing double-space is a hard line break
[*.md]
trim_trailing_whitespace = false
